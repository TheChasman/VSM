#!/usr/bin/env bash
# Local pre-commit checks for VSM. Installed by `just hooks` (sets this repo's core.hooksPath).
# A repo-level hooksPath replaces the global one, so run the global hook (SpockLock
# secret scanning) first and stop if it blocks.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

global_hooks="$(git config --global --get core.hooksPath || true)"
global_hooks="${global_hooks/#\~/$HOME}"
if [[ -n "${global_hooks}" && -x "${global_hooks}/pre-commit" ]]; then
  "${global_hooks}/pre-commit" "$@"
fi

if ! git diff --cached --name-only | grep -qE '\.rs$|Cargo\.(toml|lock)$'; then
  exit 0
fi
cargo fmt --all --check
cargo clippy --workspace --all-targets --quiet -- -D warnings
cargo test --workspace --quiet
